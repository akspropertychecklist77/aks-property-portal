<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========================================================================= -->
    <!-- 003a: ENQUIRIES & INTAKE STAGING BUFFER (Tier 1 Architecture)             -->
    <!-- ========================================================================= -->
    <changeSet id="003-create-table-enquiries" author="akspropertychecklist">
        <comment>Tier 1 intake buffer isolating public web leads from production legal dockets</comment>
        <createTable tableName="enquiries">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="client_phone" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="client_email" type="VARCHAR(150)">
                <constraints nullable="true"/>
            </column>
            <column name="service_package" type="VARCHAR(80)" defaultValue="Legal Opinion (Standard)">
                <constraints nullable="false"/>
            </column>
            <column name="district" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="property_address" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="survey_number" type="VARCHAR(120)">
                <constraints nullable="true"/>
            </column>
            <column name="client_notes" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="source" type="VARCHAR(50)" defaultValue="website">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="new">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_handler_id" type="VARCHAR(36)">
                <constraints nullable="true" foreignKeyName="fk_enquiries_handler" references="users(id)"/>
            </column>
            <column name="converted_case_id" type="VARCHAR(30)">
                <constraints nullable="true"/>
            </column>
            <column name="rejection_reason" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="enquiries" indexName="idx_enquiries_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="enquiries" indexName="idx_enquiries_phone">
            <column name="client_phone"/>
        </createIndex>
        <createIndex tableName="enquiries" indexName="idx_enquiries_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="enquiries" indexName="idx_enquiries_converted">
            <column name="converted_case_id"/>
        </createIndex>
    </changeSet>

    <!-- ========================================================================= -->
    <!-- 003b: CASES TABLE EXTENSIONS (Source Enquiry Reference & Creation Index)  -->
    <!-- ========================================================================= -->
    <changeSet id="003-alter-cases-add-source-enquiry" author="akspropertychecklist">
        <comment>Link cases to originating enquiry lead for complete audit provenance</comment>
        <addColumn tableName="cases">
            <column name="source_enquiry_id" type="VARCHAR(36)">
                <constraints nullable="true" foreignKeyName="fk_cases_source_enquiry" references="enquiries(id)"/>
            </column>
        </addColumn>
        <createIndex tableName="cases" indexName="idx_cases_enquiry">
            <column name="source_enquiry_id"/>
        </createIndex>
        <createIndex tableName="cases" indexName="idx_cases_created">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ========================================================================= -->
    <!-- 003c: REVENUE RECORDS EXTENSIONS (Chitta, FMB Sketch & File Attachments)   -->
    <!-- ========================================================================= -->
    <changeSet id="003-alter-revenue-records-add-verification-fields" author="akspropertychecklist">
        <comment>Support Tamil Nilam e-Services: Chitta/Adangal, FMB sketches, and file links</comment>
        <addColumn tableName="revenue_records">
            <column name="chitta_adangal_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="fmb_sketch_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="patta_file_url" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="patta_file_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="chitta_file_url" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="chitta_file_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="fmb_file_url" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="fmb_file_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="source_type" type="VARCHAR(50)" defaultValue="MANUAL_UPLOAD">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- ========================================================================= -->
    <!-- 003d: CASE DOCUMENTS EXTENSIONS (MIME Type & Category Index)               -->
    <!-- ========================================================================= -->
    <changeSet id="003-alter-case-documents-add-mime-type" author="akspropertychecklist">
        <comment>Support strict MIME type validation and category filtering</comment>
        <addColumn tableName="case_documents">
            <column name="mime_type" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <createIndex tableName="case_documents" indexName="idx_docs_category">
            <column name="case_id"/>
            <column name="file_category"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

